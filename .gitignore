# ===== 绝不提交到公开仓库的敏感 / 体积文件 =====

# 真实连接信息 (含真实 IP / 主机名 / Tailscale 账号)
我的连接信息.txt
linux/我的连接信息.txt

# 真实 authkey —— keys/ 下的本地副本, 供临时存放, 不入库
# (注意: 仓库里保留一个占位文件 keys/authkey.local.txt.example 作为格式说明)
linux/keys/authkey.local.txt
windows/keys/authkey.local.txt

# 预置静态二进制 (约 75MB, 通过 GitHub Release 或 stage-tailscale.sh 获取, 不入库)
linux/assets/tailscale
linux/assets/tailscaled

# Windows 预置 MSI (体积大, 通过 Release 获取, 不入库)
windows/assets/*.msi

# 便携 7-Zip 二进制 (闭源 + 体积大, 通过 builder/fetch_7zip.py 获取, 不入库)
linux/assets/7zip/
windows/assets/7zip/

# Windows 本地密钥/公钥 (不入库)
windows/keys/*.local
windows/keys/*.pub.local
windows/keys/id_ed25519*
windows/keys/authkey*

# 杂项
.DS_Store
*.swp

# 配置生成器的临时构建目录
builder/_build/
builder/_verify/
builder/_v_*/

# 传文件工具的收件目录(运行时产物, 不入库)
tools/inbox/
tools/收件箱/
程序/文件传输/inbox/

# Python 缓存
__pycache__/
*.pyc
